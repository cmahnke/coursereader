{
  "name": "@projektemacher/coursereader",
  "version": "0.1.3",
  "description": "Dependency-free DOM, CSS, and SVG archival scan and photocopy effects.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./playground": {
      "types": "./dist/playground.d.ts",
      "import": "./dist/playground.js"
    }
  },
  "files": [
    "dist",
    "playground/dist",
    "README.md"
  ],
  "scripts": {
    "build": "npm run build:styles && tsc",
    "build:all": "npm run build && npm run playground:build",
    "dist": "npm run clean && npm run build:all",
    "build:styles": "node scripts/generate-styles.mjs",
    "clean": "rimraf dist playground/dist",
    "dev": "vite playground",
    "playground:dev": "vite playground",
    "playground:build": "vite build playground",
    "playground:preview": "vite preview playground",
    "playground:typecheck": "npm run build:styles && tsc -p playground/tsconfig.json",
    "watch": "npm run build:styles && tsc --watch",
    "watch:styles": "node scripts/generate-styles.mjs --watch",
    "prepare": "npm run build:styles",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:styles": "stylelint \"src/css/**/*.css\" \"playground/index.html\"",
    "typecheck": "npm run build:styles && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "npm run lint && npm run lint:styles && npm run typecheck && npm run playground:typecheck && npm run test",
    "prepack": "npm run build:all",
    "prepublishOnly": "npm run validate",
    "docs": "typedoc"
  },
  "keywords": [
    "archive",
    "photocopy",
    "xerox",
    "microfilm",
    "bitonal",
    "dither",
    "svg-filter",
    "document"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cmahnke/coursereader.git"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.0",
    "happy-dom": "^21.0.4",
    "postcss-html": "^2.0.0",
    "prettier": "^3.5.0",
    "rimraf": "^6.1.4",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "typedoc": "^0.28.20",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.24.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
